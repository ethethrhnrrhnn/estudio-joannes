---
import { DRIP_PATH } from '../data/brand';
// Two-drips melting square + two-tier wordmark (ESTUDIO / Joannes), as set in Figma.
interface Props { size?: number; wordmark?: boolean; class?: string }
const { size = 28, wordmark = true, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} style={`--s:${size}px`}>
  <svg viewBox="0 0 200 286" width={size} height={size * 1.43} aria-hidden="true">
    <path d={DRIP_PATH} fill="currentColor" />
  </svg>
  {wordmark && (
    <span class="words">
      <span class="estudio">ESTUDIO</span>
      <span class="joannes">Joannes</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: flex-start; gap: calc(var(--s) * 0.42); }
  .words { display: flex; flex-direction: column; line-height: 1; margin-top: -0.04em; }
  .estudio { font-family: var(--mono); font-size: calc(var(--s) * 0.27); letter-spacing: 0.34em; margin-bottom: calc(var(--s) * 0.08); }
  .joannes { font-family: var(--sans); font-weight: 500; font-size: calc(var(--s) * 1.1); letter-spacing: -0.03em; }
</style>
