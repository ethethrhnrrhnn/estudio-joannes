---
import { DRIP_PATH } from '../data/brand';
// Two-drips melting square + the DRIPSQUARE wordmark (thin geometric caps).
interface Props { size?: number; wordmark?: boolean; class?: string }
const { size = 28, wordmark = true, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} style={`--s:${size}px`}>
  <svg viewBox="0 0 200 286" width={size} height={size * 1.43} aria-hidden="true">
    <path d={DRIP_PATH} fill="currentColor" />
  </svg>
  {wordmark && (
    <span class="words">
      <span class="brand">DRIPSQUARE</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--s) * 0.5); }
  .words { display: flex; align-self: center; line-height: 1; }
  .brand { font-family: var(--brand); font-weight: 300; font-size: calc(var(--s) * 0.78); letter-spacing: 0.08em; }
</style>
