---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import BuyButton from '../../components/BuyButton.astro';
import { products, categories, formatPrice } from '../../data/products';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const cat = categories.find((c) => c.slug === p.category);
---
<Base title={p.name} description={p.summary}>
  <div class="wrap">
    <nav class="crumbs muted" aria-label="Breadcrumb">
      <a href="/shop">Shop</a> / <a href={`/shop#${p.category}`}>{cat?.name}</a> / <span aria-current="page">{p.name}</span>
    </nav>
    <div class="product">
      <div class="gallery">
        {p.images.length
          ? p.images.map((src, i) => <img src={src} alt={`${p.name}, view ${i + 1}`} />)
          : <>
              <Placeholder label="Photo to come" />
              <Placeholder label="Photo to come" tone="basalt" />
            </>}
      </div>
      <div class="info">
        <h1>{p.name}</h1>
        <p class="muted">{p.material}</p>
        <p class="price">{formatPrice(p.price)}</p>
        <p>{p.summary}</p>
        <p class="finishes"><span class="muted">Finishes</span> {p.finishes.join(', ')}</p>
        <BuyButton product={p} />
        <dl>
          <div><dt>Material</dt><dd>{p.material}</dd></div>
          <div><dt>Dimensions</dt><dd>{p.dimensions}</dd></div>
          {p.weight && <div><dt>Weight</dt><dd>{p.weight}</dd></div>}
          <div><dt>Made in</dt><dd>Madrid, by hand</dd></div>
        </dl>
        <details open>
          <summary>About the object</summary>
          {p.description.map((d) => <p>{d}</p>)}
        </details>
        <details>
          <summary>Care</summary>
          <p>{p.care}</p>
        </details>
        <details>
          <summary>Shipping and returns</summary>
          <p>Ships from Madrid. Delivery times and costs are shown at checkout. You can return an unused piece within 14 days of delivery.</p>
        </details>
      </div>
    </div>
  </div>
</Base>

<style>
  .crumbs { font-size: var(--t-s); padding: 24px 0 28px; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; }
  .product { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: start; }
  .gallery { display: grid; gap: 12px; }
  .gallery img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .info { position: sticky; top: 24px; }
  h1 { font-size: var(--t-xl); }
  .info > .muted { margin: 4px 0 0; }
  .price { font-size: var(--t-l); margin: 20px 0; }
  .finishes { font-size: var(--t-s); margin-bottom: 24px; }
  .finishes .muted { margin-right: 8px; }
  dl { margin: 36px 0 0; border-top: 1px solid var(--ink); }
  dl div { display: grid; grid-template-columns: 9em 1fr; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: var(--t-s); }
  dt { color: var(--mute); }
  dd { margin: 0; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 14px 0; font-weight: 500; list-style: none; display: flex; justify-content: space-between; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-weight: 400; }
  details[open] summary::after { content: '–'; }
  details p { font-size: var(--t-s); }
  @media (max-width: 820px) {
    .product { grid-template-columns: 1fr; }
    .info { position: static; }
  }
</style>
